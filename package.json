{
  "name": "nettside-fyrk",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro build && astro preview",
    "astro": "astro",
    "typecheck": "astro check",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "test": "npm run typecheck && npm run lint && npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:smoke": "playwright test --project=smoke --project=smoke-mobile",
    "test:a11y": "playwright test --project=a11y",
    "test:ui": "playwright test --ui",
    "prepare": "husky",
    "cf-typegen": "wrangler types --env-file .dev.vars.example --include-runtime false",
    "deploy": "astro build && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.9",
    "@astrojs/react": "^7.1.9",
    "@astrojs/sitemap": "^3.7.6",
    "@fontsource/inter": "^5.2.8",
    "astro": "^7.3.4",
    "lucide-react": "^1.77.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.11.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@cloudflare/workers-types": "^5.20261121.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.70.1",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^10.15.0",
    "eslint-plugin-astro": "^3.2.1",
    "happy-dom": "^20.14.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.2",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2",
    "wrangler": "^4.137.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js}": "eslint --fix --max-warnings 0 --no-warn-ignored",
    "*.astro": "eslint --fix --max-warnings 0 --no-warn-ignored"
  },
  "overrides": {
    "undici": "^7.19.0",
    "wrangler": "^4.137.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
