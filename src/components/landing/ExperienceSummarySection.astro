---
/**
 * Short summary of the experience FYRK builds on, linking to the full
 * consultant profile on /konsulenter
 */
interface Props {
  title: string;
  lead: string;
  items: readonly string[];
  linkText: string;
  linkHref: string;
}

const { title, lead, items, linkText, linkHref } = Astro.props;
---

<section class="py-20 md:py-28 px-6 bg-white">
  <div class="max-w-3xl mx-auto">
    <h2 class="text-h2 font-semibold text-brand-navy mb-3 text-center">
      {title}
    </h2>
    <div class="w-16 h-1 bg-brand-cyan-darker mx-auto mb-8"></div>
    <p class="text-lg text-neutral-700 leading-relaxed mb-8 text-center max-w-2xl mx-auto">
      {lead}
    </p>
    <ul class="space-y-4 max-w-2xl mx-auto">
      {items.map((item) => (
        <li class="flex items-start gap-3 text-neutral-700 leading-relaxed">
          <span class="mt-2 inline-block w-1.5 h-1.5 rounded-full bg-brand-cyan-darker shrink-0" aria-hidden="true"></span>
          <span>{item}</span>
        </li>
      ))}
    </ul>
    <p class="mt-10 text-center">
      <a href={linkHref} class="font-medium text-brand-cyan-darker hover:text-brand-navy transition-colors underline underline-offset-4">
        {linkText}
      </a>
    </p>
  </div>
</section>
