---
/**
 * Landing page for FYRK
 * Hobby project: tools and texts for better product decisions
 */

import '../styles/global.css';
import SEOHead from '../components/seo/SEOHead.astro';
import Telemetry from '../components/analytics/Telemetry.astro';
import PageView from '../components/analytics/PageView.astro';
import { ELEMENT_IDS } from '../utils/constants';

// Landing page components
import LandingHeader from '../components/landing/LandingHeader.astro';
import HeroSection from '../components/landing/HeroSection.astro';
import ToolsSection from '../components/landing/ToolsSection.astro';
import InsightsSection from '../components/landing/InsightsSection.astro';
import IntroSection from '../components/landing/IntroSection.astro';
import LandingFooter from '../components/landing/LandingFooter.astro';

// Content data
import {
  navLinks,
  heroContent,
  toolsSectionContent,
  insightsSectionContent,
  aboutContent,
  footerContent,
} from '../data/landing';
---

<!doctype html>
<html lang="no" class="scroll-smooth">
  <head>
    <SEOHead
      title="Verktøy for bedre produktbeslutninger"
      description="Små verktøy og korte tekster som hjelper deg å teste OKR-er, produktideer og beslutninger før teamet bruker tid på dem."
      type="website"
    />
  </head>
  <body class="min-h-screen flex flex-col bg-neutral-50 text-neutral-700">
    <!-- Skip link for accessibility -->
    <a href={`#${ELEMENT_IDS.MAIN}`} class="skip-link">Hopp til hovedinnhold</a>

    <LandingHeader navLinks={navLinks} />

    <main id={ELEMENT_IDS.MAIN} class="flex-1">
      <HeroSection {...heroContent} />

      <ToolsSection {...toolsSectionContent} />

      <InsightsSection {...insightsSectionContent} />

      <IntroSection {...aboutContent} />
    </main>

    <LandingFooter {...footerContent} />

    <script>
      import { initMobileMenu } from '../scripts/mobile-menu';
      initMobileMenu();
    </script>
    <PageView pageId="home" />
    <Telemetry />
  </body>
</html>
