---
export const prerender = false;

import { env } from 'cloudflare:workers';
import { getCollection } from 'astro:content';
import { TRACKED_BUTTONS } from './api/track';
import { TRACKED_PAGES } from './api/pageview';
import { AnalyticsDashboard } from '../components/dashboard/AnalyticsDashboard';
import { resolveTokenGate, serializeCookie, STATS_TOKEN_COOKIE } from '../lib/token-cookie';
import { loadStats, parsePeriod, type StatsData } from '../lib/stats-data';
import '../styles/global.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';

// Get the secret token from environment
const expectedToken = env.STATS_TOKEN;

const url = new URL(Astro.request.url);

const period = parsePeriod(url.searchParams.get('period'));

// Prevent CDN caching — always serve fresh data
Astro.response.headers.set('Cache-Control', 'no-store');

// Token arrives in the URL on first visit and is exchanged for an httpOnly
// cookie, so the secret stops travelling in URLs, history and logs.
const gate = resolveTokenGate(
  url,
  Astro.cookies.get(STATS_TOKEN_COOKIE.name)?.value,
  expectedToken,
  STATS_TOKEN_COOKIE
);
if (gate.status === 'redirect') return gate.response;

// Drop a stale cookie (e.g. after token rotation) so the error page isn't sticky.
if (gate.status === 'mismatch' && gate.clearCookie) {
  Astro.cookies.delete(STATS_TOKEN_COOKIE.name, { path: STATS_TOKEN_COOKIE.path });
}

// Re-issue the cookie so one set before the path became '/' also reaches the API
const cookieToken = Astro.cookies.get(STATS_TOKEN_COOKIE.name)?.value;
if (gate.status === 'granted' && cookieToken) {
  Astro.response.headers.append('Set-Cookie', serializeCookie(cookieToken, STATS_TOKEN_COOKIE));
}

const tokenNotConfigured = gate.status === 'not-configured';
const tokenProvided = gate.status !== 'missing';
const tokenMismatch = gate.status === 'mismatch';
const hasAccess = gate.status === 'granted';

let stats: StatsData | null = null;
let loadFailed = false;
let dataTimestamp: number | null = null;

if (hasAccess && env.STATS_DB) {
  dataTimestamp = Date.now();
  try {
    const insights = await getCollection('innsikt', ({ data }) => !data.draft);
    stats = await loadStats(env.STATS_DB, period, {
      buttons: TRACKED_BUTTONS,
      pages: TRACKED_PAGES,
      articles: insights.map((entry) => ({ slug: entry.id, title: entry.data.title })),
    }, dataTimestamp);
  } catch (error) {
    console.error('Stats loading failed:', error);
    loadFailed = true;
  }
}
---

<!DOCTYPE html>
<html lang="no">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex, nofollow">
  <link rel="icon" type="image/svg+xml" href="/fyrk-monogram-primary-navy.svg" />
  <title>Analytics - FYRK</title>
  <style is:global>
    /* No `*` reset here: Tailwind's preflight already does it, and an unlayered
       reset would override every layered spacing utility under Tailwind 4. */
    html {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }
  </style>
</head>
<body>
  {tokenNotConfigured ? (
    <div class="min-h-screen bg-slate-50 flex items-center justify-center p-4">
      <div class="bg-white border border-amber-200 rounded-2xl p-8 text-center max-w-md shadow-lg">
        <div class="w-16 h-16 bg-amber-100 rounded-full flex items-center justify-center mx-auto mb-4">
          <svg class="w-8 h-8 text-amber-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
          </svg>
        </div>
        <h1 class="text-xl font-bold text-slate-900 mb-2">STATS_TOKEN ikke konfigurert</h1>
        <p class="text-slate-500">Legg til STATS_TOKEN som secret p&aring; Cloudflare-workeren.</p>
      </div>
    </div>
  ) : !tokenProvided ? (
    <div class="min-h-screen bg-slate-50 flex items-center justify-center p-4">
      <div class="bg-white border border-slate-200 rounded-2xl p-8 text-center max-w-md shadow-lg">
        <div class="w-16 h-16 bg-slate-100 rounded-full flex items-center justify-center mx-auto mb-4">
          <svg class="w-8 h-8 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z" />
          </svg>
        </div>
        <h1 class="text-xl font-bold text-slate-900 mb-2">Token mangler</h1>
        <p class="text-slate-500">Legg til <code>?token=&lt;STATS_TOKEN&gt;</code> i URL-en for &aring; &aring;pne dashboardet.</p>
      </div>
    </div>
  ) : tokenMismatch ? (
    <div class="min-h-screen bg-slate-50 flex items-center justify-center p-4">
      <div class="bg-white border border-red-200 rounded-2xl p-8 text-center max-w-md shadow-lg">
        <div class="w-16 h-16 bg-red-100 rounded-full flex items-center justify-center mx-auto mb-4">
          <svg class="w-8 h-8 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
          </svg>
        </div>
        <h1 class="text-xl font-bold text-slate-900 mb-2">Feil token</h1>
        <p class="text-slate-500">Token matcher ikke STATS_TOKEN.</p>
      </div>
    </div>
  ) : stats ? (
    <AnalyticsDashboard
      client:visible
      period={period}
      buttonCounts={stats.buttonCounts}
      pageStats={stats.pageStats}
      totalClicks={stats.totalClicks}
      siteVisitors={stats.siteVisitors}
      toolMetrics={stats.toolMetrics}
      articleStats={stats.articleStats}
      audience={stats.audience}
      notFoundPaths={stats.notFoundPaths}
      dataTimestamp={dataTimestamp ?? Date.now()}
    />
  ) : loadFailed ? (
    <div class="min-h-screen bg-slate-50 flex items-center justify-center p-4">
      <div class="bg-white border border-red-200 rounded-2xl p-8 text-center max-w-md shadow-lg" data-testid="stats-load-error">
        <h1 class="text-xl font-bold text-slate-900 mb-2">Kunne ikke laste statistikk</h1>
        <p class="text-slate-500 mb-4">Lagringen svarte ikke. Prøv igjen om litt.</p>
        <a href={`/stats?period=${period}`} class="inline-flex px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-lg text-sm font-medium">Prøv igjen</a>
      </div>
    </div>
  ) : (
    <div class="min-h-screen bg-slate-50 flex items-center justify-center p-4">
      <div class="bg-white border border-amber-200 rounded-2xl p-8 text-center max-w-md shadow-lg">
        <div class="w-16 h-16 bg-amber-100 rounded-full flex items-center justify-center mx-auto mb-4">
          <svg class="w-8 h-8 text-amber-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
          </svg>
        </div>
        <h1 class="text-xl font-bold text-slate-900 mb-2">Statistikkdatabasen mangler</h1>
        <p class="text-slate-500">D1-bindingen <code>STATS_DB</code> er ikke satt opp.</p>
      </div>
    </div>
  )}
</body>
</html>
