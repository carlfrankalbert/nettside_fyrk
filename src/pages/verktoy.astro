---
/**
 * Dedicated tools page
 * Groups all FYRK tools by intent
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageView from '../components/analytics/PageView.astro';
import ToolCard from '../components/ui/ToolCard.astro';
import { verktoyPageContent } from '../data/verktoy';

const { seo, title, subtitle, tagline, sections, disclaimerHtml } = verktoyPageContent;
---

<BaseLayout
  title={seo.title}
  description={seo.description}
>
  <article class="py-16 md:py-24 px-6">
    <div class="max-w-3xl mx-auto">

      <!-- Header -->
      <header class="mb-16">
        <h1 class="text-h2 md:text-h1 font-semibold text-brand-navy mb-4 leading-tight">
          {title}
        </h1>
        <p class="text-xl md:text-2xl text-neutral-600 leading-relaxed md:leading-8 mb-3">
          {subtitle}
        </p>
        <p class="text-base text-neutral-500">
          {tagline}
        </p>
      </header>

      {sections.map((section) => (
        <section class="mb-16">
          <h2 class="text-h3 font-semibold text-brand-navy mb-6">{section.heading}</h2>
          <div class="space-y-4">
            {section.tools.map((tool) => (
              <ToolCard
                name={tool.name}
                description={tool.description}
                href={tool.href}
                cta={tool.cta}
                badge={'badge' in tool ? tool.badge : undefined}
              />
            ))}
          </div>
        </section>
      ))}

      <!-- Disclaimer -->
      {disclaimerHtml && <p class="text-sm text-neutral-500 mb-16" set:html={disclaimerHtml} />}

    </div>
  </article>
  <PageView pageId="verktoy" />
</BaseLayout>
